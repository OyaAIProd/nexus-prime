# Nexus Prime Configuration

# Network
NEXUS_PORT=3000
NEXUS_PEERS=
NEXUS_CONSENSUS=raft

# Memory
NEXUS_CORTEX_ENABLED=true
NEXUS_CORTEX_STORAGE=sqlite
NEXUS_VECTOR=hnsw
NEXUS_HIPPOCAMPUS_WINDOW=48h
NEXUS_PREFRONTAL_ITEMS=7

# Embeddings (local | api | ollama | huggingface)
NEXUS_EMBED_MODE=local

# OpenAI API (when NEXUS_EMBED_MODE=api)
NEXUS_EMBED_URL=https://api.openai.com/v1/embeddings
NEXUS_EMBED_KEY=your-api-key-here
NEXUS_EMBED_MODEL=text-embedding-3-small

# Ollama (when NEXUS_EMBED_MODE=ollama)
NEXUS_OLLAMA_ENDPOINT=http://localhost:11434
NEXUS_OLLAMA_MODEL=nomic-embed-text

# HuggingFace (when NEXUS_EMBED_MODE=huggingface)
NEXUS_HF_API_KEY=your-hf-token-here
NEXUS_HF_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Evolution
NEXUS_MUTATION_RATE=0.01
NEXUS_SELECTION_PRESSURE=0.9
NEXUS_COHERENCE_THRESHOLD=0.8

# Adapters (comma-separated)
NEXUS_ADAPTERS=openclaw,claude-code,ruflo

# Logging
NEXUS_LOG_LEVEL=info
